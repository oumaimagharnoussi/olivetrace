# Avec l'utilisateur root sans mot de passe : mysql://root@localhost:3306/olivetrace?allowPublicKeyRetrieval=true
DATABASE_URL="mysql://olivetrace:olivetrace@localhost:3306/olivetrace?allowPublicKeyRetrieval=true"
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="8h"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
ALERTE_DUREE_STOCKAGE_JOURS=180
# Au-delà, une analyse est jugée ancienne (alerte qualité et avertissement avant une vente).
ALERTE_AGE_ANALYSE_JOURS=90

# Conditionnement : masse volumique de l'huile (kg par litre) pour calculer l'huile mise en bouteille,
# et durée par défaut de la DLUO (date de durabilité minimale) en mois.
DENSITE_HUILE_KG_L=0.916
DLUO_MOIS=18

# Adresse du frontend, utilisée dans les liens envoyés par e-mail.
WEB_URL="http://localhost:3000"

# Passeport produit (QR code). Adresse publique ouverte par le téléphone qui scanne le QR code :
# laissée vide, c'est WEB_URL. Pour tester avec un téléphone sur le même Wi-Fi, mettre l'adresse IP du PC,
# ex. http://192.168.1.20:3000 ; en production, le domaine public (ex. https://trace.olived.tn).
PASSEPORT_WEB_URL=""
# Clé de signature des numéros de bouteille (laissée vide : JWT_SECRET). Ne plus la changer une fois des étiquettes imprimées.
PASSEPORT_SECRET=""
PASSEPORT_PRODUCTEUR="OLIVED"

# Export : exportateur imprimé sur les documents PDF (colisage, certificat d'origine, déclaration de conformité…).
EXPORTATEUR_RAISON_SOCIALE="OLIVED"
EXPORTATEUR_ADRESSE=""
EXPORTATEUR_PAYS="Tunisie"
EXPORTATEUR_MATRICULE_FISCAL=""
EXPORTATEUR_CODE_DOUANE=""
# Numéro d'exportateur agréé (déclaration d'origine sur facture au-delà de 6 000 €) ; vide : pointillés à compléter.
EXPORTATEUR_AGREE=""
EXPORTATEUR_TELEPHONE=""
EXPORTATEUR_EMAIL=""
EXPORTATEUR_SIGNATAIRE=""
EXPORTATEUR_FONCTION=""
EXPORTATEUR_LIEU=""
# Navigateur utilisé par Puppeteer pour les PDF. Vide : le Chrome installé par npm install, sinon Edge ou Chrome du poste.
# Ex. CHROME_PATH='C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'
CHROME_PATH=""

# Envoi des e-mails (inscriptions, mot de passe oublié).
# Sans SMTP_HOST, les e-mails sont affichés dans la console de l'API.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="OliveTrace <no-reply@olived.tn>"

# Blockchain (option) : le journal d'audit est scellé par lots, et l'empreinte de chaque lot est inscrite sur Polygon.
# Sans adresse RPC ni clé, les lots sont seulement scellés dans la base (la vérification d'intégrité marche quand même).
# Test gratuit : réseau Polygon Amoy (https://rpc-amoy.polygon.technology), jetons POL de test sur https://faucet.polygon.technology.
# Production : réseau Polygon (ex. https://polygon-rpc.com) ; chaque ancrage coûte une fraction de centime en POL.
BLOCKCHAIN_RPC_URL=""
# Clé privée d'un portefeuille dédié à OliveTrace (0x… 64 caractères hexadécimaux). Ne jamais la mettre dans Git.
BLOCKCHAIN_CLE_PRIVEE=""
# Fréquence des ancrages automatiques en minutes (0 : seulement avec le bouton « Ancrer maintenant »).
BLOCKCHAIN_INTERVALLE_MINUTES=60
BLOCKCHAIN_CONFIRMATIONS=1
