// OliveTrace : schéma de données.
// Étape 1 (socle) : utilisateurs et rôles, référentiels (huileries, variétés, cuves/citernes, clients), journal d'audit.
// Étape 2 (flux vrac) : lots, analyses, opérations de stock (réception, transfert, assemblage, sortie), livraisons.
// Étape 3 (qualité) : critères de qualité, résultat de chaque analyse, non-conformités et blocage des lots.
// Étape 4 (conditionnement) : filtration, mise en bouteille (lots conditionnés) et stock de produits finis.
// Étape 5 (passeport produit) : QR code de chaque lot conditionné et de chaque bouteille, page publique.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  DIRECTION
  STOCK
  QUALITE
  PRODUCTION
  EXPORT
}

enum TypeStockage {
  CUVE_SOUTERRAINE // cuve enterrée, 24 t par défaut
  CITERNE // citerne, 30 t par défaut
  CUVE_TAMPON // cuve de l'atelier de conditionnement : huile filtrée en attente de mise en bouteille
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(191)
  passwordHash String
  nom          String   @db.VarChar(120)
  role         Role? // vide pour une inscription en attente : l'administrateur attribue le rôle
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs   AuditLog[]
  operations  Operation[]
  resetTokens PasswordResetToken[]

  nonConformitesOuvertes  NonConformite[]        @relation("NcOuvertePar")
  nonConformitesCloturees NonConformite[]        @relation("NcClotureePar")
  mouvementsProduits      MouvementProduitFini[]
}

// Lien de réinitialisation du mot de passe : seul le hash SHA-256 du jeton est stocké.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Huilerie {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(32)
  nom       String   @db.VarChar(160)
  region    String?  @db.VarChar(120)
  adresse   String?  @db.VarChar(255)
  telephone String?  @db.VarChar(40)
  agrement  String?  @db.VarChar(80) // numéro d'agrément sanitaire
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lots Lot[]
}

model Variete {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(32)
  nom         String   @db.VarChar(120) // ex. Chemlali, Chétoui, Oueslati
  description String?  @db.Text
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lots Lot[]
}

model Stockage {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(32)
  type        TypeStockage
  capaciteKg  Int // capacité en kilogrammes (24 000 pour une cuve, 30 000 pour une citerne)
  emplacement String?      @db.VarChar(160)
  actif       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  mouvements Mouvement[]
}

model Client {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(32)
  raisonSociale String   @db.VarChar(200)
  pays          String   @db.VarChar(2) // code ISO 3166-1 alpha-2
  ville         String?  @db.VarChar(120)
  adresse       String?  @db.VarChar(255)
  email         String?  @db.VarChar(191)
  telephone     String?  @db.VarChar(40)
  numeroTva     String?  @db.VarChar(40)
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  operations         Operation[]
  specifications     Specification[] // cahiers des charges qualité du client
  lotsConditionnes   LotConditionne[]
  mouvementsProduits MouvementProduitFini[]
}

// Journal de toutes les modifications : base de la traçabilité et de l'option blockchain.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(16) // CREATE, UPDATE, DELETE
  entite    String   @db.VarChar(64)
  entiteId  String   @db.VarChar(64)
  donnees   Json?
  createdAt DateTime @default(now())

  @@index([entite, entiteId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Étape 2 : flux vrac
// ---------------------------------------------------------------------------
// Règles :
// - le stock n'est jamais saisi directement : il est la somme des mouvements (+ entrée, - sortie) par lot et par cuve ;
// - une cuve ou citerne ne contient qu'un seul lot à la fois ; mettre deux lots ensemble est un assemblage,
//   qui crée un nouveau lot relié à ses lots d'origine (généalogie) ;
// - les quantités sont en kilogrammes, comme la capacité des cuves.

enum OrigineLot {
  RECEPTION // huile reçue d'une huilerie
  ASSEMBLAGE // mélange de plusieurs lots
  FILTRATION // huile filtrée à partir d'un lot
}

enum TypeOperation {
  RECEPTION
  TRANSFERT
  ASSEMBLAGE
  SORTIE
  FILTRATION // passage d'un lot dans le filtre, d'une cuve vers une autre
  CONDITIONNEMENT // mise en bouteille : l'huile sort de la cuve et devient un lot conditionné
}

enum MotifSortie {
  VENTE // vente en vrac à un client
  CONDITIONNEMENT // ancien motif : depuis l'étape 4, la filtration et la mise en bouteille ont leurs propres opérations
  PERTE // perte, lie, écart d'inventaire
  AUTRE
}

enum StatutLivraison {
  PLANIFIEE
  EN_COURS
  LIVREE
  ANNULEE
}

model Lot {
  id                 Int            @id @default(autoincrement())
  code               String         @unique @db.VarChar(32) // ex. L2026-0001
  origine            OrigineLot
  huilerieId         Int?
  huilerie           Huilerie?      @relation(fields: [huilerieId], references: [id])
  varieteId          Int? // vide pour un assemblage de plusieurs variétés
  variete            Variete?       @relation(fields: [varieteId], references: [id])
  campagne           String?        @db.VarChar(9) // ex. 2026/2027
  dateReception      DateTime // date de réception ou d'assemblage
  quantiteInitialeKg Int
  numeroBon          String?        @db.VarChar(64) // bon de réception de l'huilerie
  notes              String?        @db.Text
  categorieVisee     CategorieHuile @default(EXTRA_VIERGE) // qualité attendue, contrôlée à chaque analyse
  statutQualite      StatutQualite  @default(NON_ANALYSE) // résultat de la dernière analyse
  bloque             Boolean        @default(false) // une non-conformité ouverte bloque la vente et le conditionnement
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  analyses       Analyse[]
  nonConformites NonConformite[]
  mouvements     Mouvement[]
  origines       LotOrigine[]    @relation("LotEnfant") // lots qui composent cet assemblage ou ce lot filtré
  enfants        LotOrigine[]    @relation("LotParent") // assemblages et lots filtrés faits à partir de ce lot

  filtrations      Filtration[]     @relation("FiltrationEntree") // filtrations faites à partir de ce lot
  filtration       Filtration?      @relation("FiltrationSortie") // pour un lot filtré : la filtration qui l'a produit
  lotsConditionnes LotConditionne[]

  @@index([dateReception])
}

// Généalogie : un lot d'assemblage et la quantité prise à chacun de ses lots d'origine.
model LotOrigine {
  lotId      Int
  lot        Lot @relation("LotEnfant", fields: [lotId], references: [id])
  parentId   Int
  parent     Lot @relation("LotParent", fields: [parentId], references: [id])
  quantiteKg Int

  @@id([lotId, parentId])
}

// Analyse de laboratoire d'un lot. À l'enregistrement, elle est comparée aux critères de qualité :
// le résultat (catégorie, conformité, écarts) est gardé tel qu'il a été calculé ce jour-là.
model Analyse {
  id              Int             @id @default(autoincrement())
  lotId           Int
  lot             Lot             @relation(fields: [lotId], references: [id])
  dateAnalyse     DateTime
  laboratoire     String?         @db.VarChar(160)
  reference       String?         @db.VarChar(64) // n° du bulletin d'analyse
  acidite         Decimal?        @db.Decimal(5, 2) // % acide oléique
  peroxyde        Decimal?        @db.Decimal(6, 2) // meq O2/kg
  k232            Decimal?        @db.Decimal(5, 3)
  k270            Decimal?        @db.Decimal(5, 3)
  deltaK          Decimal?        @db.Decimal(5, 3)
  polyphenols     Int? // mg/kg
  esterEthyliques Decimal?        @db.Decimal(6, 1) // esters éthyliques des acides gras, mg/kg
  medianeDefaut   Decimal?        @db.Decimal(3, 1) // dégustation : médiane du défaut
  medianeFruite   Decimal?        @db.Decimal(3, 1) // dégustation : médiane du fruité
  autres          Json? // autres paramètres libres
  commentaire     String?         @db.Text
  categorie       CategorieHuile? // catégorie atteinte d'après les critères
  resultat        StatutQualite? // par rapport à la catégorie visée du lot
  ecarts          Json? // critères non respectés : [{ parametre, valeur, min, max }]
  createdAt       DateTime        @default(now())

  nonConformites NonConformite[]

  @@index([lotId, dateAnalyse])
}

// Une opération de stock (réception, transfert, assemblage, sortie) et ses mouvements.
model Operation {
  id        Int           @id @default(autoincrement())
  type      TypeOperation
  date      DateTime
  userId    Int?
  user      User?         @relation(fields: [userId], references: [id])
  motif     MotifSortie? // sorties seulement
  clientId  Int?
  client    Client?       @relation(fields: [clientId], references: [id])
  notes     String?       @db.Text
  createdAt DateTime      @default(now())

  mouvements     Mouvement[]
  livraison      Livraison?
  filtration     Filtration?
  lotConditionne LotConditionne?

  @@index([date])
}

// Entrée (+) ou sortie (-) d'une quantité d'un lot dans une cuve.
model Mouvement {
  id          Int       @id @default(autoincrement())
  operationId Int
  operation   Operation @relation(fields: [operationId], references: [id])
  lotId       Int
  lot         Lot       @relation(fields: [lotId], references: [id])
  stockageId  Int
  stockage    Stockage  @relation(fields: [stockageId], references: [id])
  quantiteKg  Int // positif = entrée dans la cuve, négatif = sortie

  @@index([stockageId, lotId])
  @@index([lotId])
}

// Transport sous-traité d'une sortie vers le client.
model Livraison {
  id                  Int             @id @default(autoincrement())
  operationId         Int             @unique
  operation           Operation       @relation(fields: [operationId], references: [id])
  transporteur        String          @db.VarChar(160)
  immatriculation     String?         @db.VarChar(32)
  chauffeur           String?         @db.VarChar(120)
  numeroBl            String?         @db.VarChar(64) // bon de livraison
  adresseLivraison    String?         @db.VarChar(255)
  dateEnlevement      DateTime?
  dateLivraisonPrevue DateTime?
  dateLivraison       DateTime? // date de livraison effective
  statut              StatutLivraison @default(PLANIFIEE)
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([statut])
}

// ---------------------------------------------------------------------------
// Étape 3 : contrôle qualité
// ---------------------------------------------------------------------------
// Règles :
// - chaque analyse est comparée aux critères des catégories (extra vierge, vierge) et à la catégorie visée du lot ;
// - une analyse non conforme ouvre une non-conformité et bloque le lot : plus de vente ni d'envoi au conditionnement
//   tant qu'elle n'est pas clôturée avec une décision (contre-analyse, déclassement, dérogation…) ;
// - avant une vente, le lot est aussi comparé au cahier des charges du client, s'il en a un.

enum CategorieHuile {
  EXTRA_VIERGE
  VIERGE
  LAMPANTE // ne respecte pas les critères de l'huile vierge
}

enum StatutQualite {
  NON_ANALYSE
  CONFORME
  INCOMPLET // aucun écart, mais des paramètres de la catégorie visée n'ont pas été mesurés
  NON_CONFORME
}

enum ParametreAnalyse {
  ACIDITE
  PEROXYDE
  K232
  K270
  DELTA_K
  POLYPHENOLS
  ESTERS_ETHYLIQUES
  MEDIANE_DEFAUT
  MEDIANE_FRUITE
}

enum StatutNonConformite {
  OUVERTE
  EN_TRAITEMENT
  CLOTUREE
}

enum DecisionNonConformite {
  CONTRE_ANALYSE_CONFORME // une nouvelle analyse est conforme
  DECLASSEMENT // le lot passe dans la catégorie atteinte
  ASSEMBLAGE_CORRECTIF // le lot sera assemblé pour corriger sa qualité
  DEROGATION // accepté en l'état (accord du client ou de la direction)
  DESTRUCTION
  AUTRE
}

// Ensemble de critères : une catégorie réglementaire (règlement UE 2022/2104) ou le cahier des charges d'un client.
model Specification {
  id        Int             @id @default(autoincrement())
  code      String          @unique @db.VarChar(32)
  nom       String          @db.VarChar(160)
  categorie CategorieHuile? @unique // critères réglementaires d'une catégorie
  clientId  Int? // cahier des charges d'un client
  client    Client?         @relation(fields: [clientId], references: [id])
  actif     Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  criteres CritereQualite[]

  @@index([clientId])
}

// Limite d'un paramètre : minimum et/ou maximum, bornes comprises.
model CritereQualite {
  id              Int              @id @default(autoincrement())
  specificationId Int
  specification   Specification    @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  parametre       ParametreAnalyse
  min             Decimal?         @db.Decimal(8, 3)
  max             Decimal?         @db.Decimal(8, 3)

  @@unique([specificationId, parametre])
}

model NonConformite {
  id               Int                    @id @default(autoincrement())
  code             String                 @unique @db.VarChar(32) // ex. NC2026-0001
  lotId            Int
  lot              Lot                    @relation(fields: [lotId], references: [id])
  analyseId        Int? // vide pour une non-conformité saisie à la main
  analyse          Analyse?               @relation(fields: [analyseId], references: [id])
  description      String                 @db.Text
  statut           StatutNonConformite    @default(OUVERTE)
  decision         DecisionNonConformite?
  actionCorrective String?                @db.Text
  ouverteParId     Int?
  ouvertePar       User?                  @relation("NcOuvertePar", fields: [ouverteParId], references: [id])
  clotureeParId    Int?
  clotureePar      User?                  @relation("NcClotureePar", fields: [clotureeParId], references: [id])
  clotureeLe       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([lotId])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Étape 4 : filtration et conditionnement
// ---------------------------------------------------------------------------
// Règles :
// - seul un lot analysé, conforme et non bloqué peut être filtré ou mis en bouteille (contrôle de l'étape 3) ;
// - la filtration fait passer l'huile d'une cuve vers une autre (souvent une cuve tampon) et crée un lot filtré,
//   relié au lot d'entrée ; tant qu'il n'a pas sa propre analyse, le lot filtré reprend la qualité du lot d'entrée ;
// - la mise en bouteille sort l'huile de sa cuve et crée un lot conditionné (numéro imprimé sur l'étiquette) ;
// - le stock de produits finis, en unités (bouteilles, bidons), est la somme des mouvements de chaque lot conditionné.

enum TypeMouvementProduit {
  CONDITIONNEMENT // entrée en stock à la mise en bouteille
  EXPEDITION // vente ou expédition à un client
  CASSE // casse, échantillons, pertes
  AJUSTEMENT // correction d'inventaire (+ ou -)
}

// Contenant : bouteille, bidon… (référentiel).
model FormatConditionnement {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(32) // ex. VER-750
  nom             String   @db.VarChar(120) // ex. Bouteille verre 75 cl
  contenanceMl    Int // 250, 500, 750, 1000, 5000…
  materiau        String?  @db.VarChar(60) // verre, PET, fer blanc
  unitesParCarton Int?
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lots LotConditionne[]
}

// Filtration d'un lot : l'huile passe d'une cuve à une autre et forme un lot filtré.
model Filtration {
  id               Int       @id @default(autoincrement())
  code             String    @unique @db.VarChar(32) // ex. F2026-0001
  operationId      Int       @unique
  operation        Operation @relation(fields: [operationId], references: [id])
  lotEntreeId      Int
  lotEntree        Lot       @relation("FiltrationEntree", fields: [lotEntreeId], references: [id])
  lotSortieId      Int       @unique
  lotSortie        Lot       @relation("FiltrationSortie", fields: [lotSortieId], references: [id])
  quantiteEntreeKg Int // huile prise dans la cuve de départ
  quantiteSortieKg Int // huile filtrée obtenue ; la différence est la perte de filtration
  operateur        String    @db.VarChar(120)
  typeFiltre       String?   @db.VarChar(80) // ex. plaques de cellulose, cartouches, terre de diatomée
  porositeMicrons  Decimal?  @db.Decimal(6, 1)
  pressionBar      Decimal?  @db.Decimal(5, 2)
  temperatureC     Decimal?  @db.Decimal(4, 1)
  debitLh          Int? // débit en litres par heure
  dureeMinutes     Int?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())

  @@index([lotEntreeId])
}

// Lot conditionné : une mise en bouteille d'un lot, identifiée par le numéro de lot final imprimé sur l'étiquette.
model LotConditionne {
  id              Int                   @id @default(autoincrement())
  code            String                @unique @db.VarChar(32) // numéro de lot final, ex. C2026-0001
  operationId     Int                   @unique
  operation       Operation             @relation(fields: [operationId], references: [id])
  lotVracId       Int
  lotVrac         Lot                   @relation(fields: [lotVracId], references: [id])
  formatId        Int
  format          FormatConditionnement @relation(fields: [formatId], references: [id])
  nombreUnites    Int
  quantiteKg      Int // huile prise dans la cuve
  dluo            DateTime? // date de durabilité minimale (« à consommer de préférence avant »)
  clientId        Int? // client ou commande pour laquelle le lot est conditionné
  client          Client?               @relation(fields: [clientId], references: [id])
  paysDestination String?               @db.VarChar(2) // code ISO 3166-1 alpha-2
  destination     String?               @db.VarChar(160) // marché, commande, marque
  operateur       String?               @db.VarChar(120)
  notes           String?               @db.Text
  createdAt       DateTime              @default(now())

  mouvements MouvementProduitFini[]
  passeport  Passeport?

  @@index([lotVracId])
}

// Entrée (+) ou sortie (-) d'unités d'un lot conditionné dans le stock de produits finis.
model MouvementProduitFini {
  id               Int                  @id @default(autoincrement())
  lotConditionneId Int
  lotConditionne   LotConditionne       @relation(fields: [lotConditionneId], references: [id])
  type             TypeMouvementProduit
  date             DateTime
  quantiteUnites   Int // positif = entrée, négatif = sortie
  clientId         Int?
  client           Client?              @relation(fields: [clientId], references: [id])
  reference        String?              @db.VarChar(64) // bon de livraison, facture
  userId           Int?
  user             User?                @relation(fields: [userId], references: [id])
  notes            String?              @db.Text
  createdAt        DateTime             @default(now())

  @@index([lotConditionneId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Étape 5 : passeport produit (QR code)
// ---------------------------------------------------------------------------
// Règles :
// - chaque lot conditionné a un passeport : une page publique, sans connexion, à l'adresse /p/{jeton} ;
// - le jeton est tiré au hasard : on ne peut pas deviner l'adresse d'un autre lot à partir d'un numéro ;
// - le QR code d'une bouteille ajoute son numéro (1 à nombre d'unités) et une signature, vérifiée à la lecture ;
// - la page ne montre que ce qui est autorisé : jamais le client, les quantités, les opérateurs ni les notes internes,
//   et chaque rubrique (huileries, analyses, procédé, destination) peut être masquée.

model Passeport {
  id                   Int            @id @default(autoincrement())
  lotConditionneId     Int            @unique
  lotConditionne       LotConditionne @relation(fields: [lotConditionneId], references: [id])
  jeton                String         @unique @db.VarChar(32)
  publie               Boolean        @default(true) // décoché, la page publique répond « passeport indisponible »
  nomProduit           String?        @db.VarChar(160) // ex. Huile d'olive vierge extra OLIVED
  description          String?        @db.Text
  certifications       Json? // libellés affichés tels quels, ex. ["Agriculture biologique UE (TN-BIO-001)"]
  afficherHuileries    Boolean        @default(true)
  afficherAnalyses     Boolean        @default(true)
  afficherProcede      Boolean        @default(true)
  afficherDestination  Boolean        @default(true)
  consultations        Int            @default(0)
  derniereConsultation DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}
